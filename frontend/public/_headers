# Static hashed assets: permanent cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static GeoJSON map data: 1h freshness, 24h background revalidate
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Entry point index.html: never cache so deployments are picked up instantly
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
