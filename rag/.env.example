# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mplads_rag
POSTGRES_USER=mplads
POSTGRES_PASSWORD=mplads_secure_password_123

# LLM Provider
# Options: "auto" (tries gemini, then groq), "gemini", or "groq"
LLM_PROVIDER=auto

# Gemini (Primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (Fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Memory
MEMORY_MAX_SHORT_TERM=20
MEMORY_SUMMARY_THRESHOLD=10

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Upload
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
