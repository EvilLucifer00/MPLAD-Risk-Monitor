# ─── PostgreSQL (RAG Database) ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mplads_rag
POSTGRES_USER=mplads
POSTGRES_PASSWORD=mplads_secure_password_123

# ─── Supabase (Main Platform — read-only for project data) ────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ─── JWT (shared secret with main backend for token verification) ──
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# ─── LLM Providers ────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_HEAVY=gemini-2.5-pro

GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile

# ─── LLM Router Strategy ──────────────────────────────────────────
# "cost_optimized" | "quality_first" | "latency_first"
LLM_ROUTER_STRATEGY=cost_optimized

# ─── Embeddings ────────────────────────────────────────────────────
# Default: all-MiniLM-L6-v2 (384 dim, fast, CPU-friendly)
# Alternative: BAAI/bge-base-en-v1.5 (768 dim, higher accuracy)
# IMPORTANT: Must match the model used to create your ChromaDB vectors!
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── Reranker ──────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─── Retrieval ─────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# ─── Cache ─────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=24

# ─── Memory ────────────────────────────────────────────────────────
MEMORY_MAX_SHORT_TERM=20
MEMORY_SUMMARY_THRESHOLD=10

# ─── Guardrails ────────────────────────────────────────────────────
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_INPUT_LENGTH=2000
GUARDRAILS_BLOCK_PII=true
GUARDRAILS_GROUNDING_THRESHOLD=0.6

# ─── ChromaDB ──────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=mplads_documents

# ─── Server ────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── Upload ────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
